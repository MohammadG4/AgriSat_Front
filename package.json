{
  "name": "agrisat-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('.next', {recursive: true, force: true});\"",
    "dev:clean": "npm run clean && next dev",
    "prebuild": "node -e \"const fs=require('fs'); fs.mkdirSync('.next/diagnostics', {recursive: true});\"",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.2",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/mapbox-gl": "^3.4.1",
    "lucide-react": "^0.468.0",
    "mapbox-gl": "^3.32.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "typescript": "^5.7.2"
  }
}
